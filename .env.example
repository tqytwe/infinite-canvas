# 管理员账号，首次启动会自动创建。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=infinite-canvas

# JWT 登录密钥和过期时间，正式部署请修改 JWT_SECRET。
JWT_SECRET=infinite-canvas
JWT_EXPIRE_HOURS=168

# 后端默认监听 8080，如需本地开发修改端口再取消注释。
# Docker 镜像内前端固定监听 3000，避免覆盖前端 PORT。
# PORT=8080

# 公开访问地址，用于把本地上传的 Seedance 参考图/视频暴露给火山方舟拉取。
# 线上部署时填写站点根地址，例如：https://your-domain.example.com
# PUBLIC_BASE_URL=https://your-domain.example.com

# 极速蹬统一登录（同时填写 API 地址与兑换密钥后生效）。
# 启用后普通用户只能从极速蹬进入 Canvas；Canvas 只换取平台用户 ID，
# 不会接收平台 API Key、分组或计费会话。CANVAS_EXCHANGE_SECRET 必须和
# 极速蹬服务的 nextchat.exchange_secret 完全一致，真实值只保存在服务环境变量中。
# CANVAS_PLATFORM_API_BASE_URL=https://api.jisudeng.com
# CANVAS_PLATFORM_WEB_URL=https://www.jisudeng.com
# CANVAS_PLATFORM_ENTRY_PATH=/ai-creation-space
# CANVAS_EXCHANGE_SECRET=replace-with-shared-secret

# 前端开发代理默认使用 http://127.0.0.1:8080，如后端开发端口不同，启动前端时可单独设置 API_BASE_URL。
# API_BASE_URL=http://127.0.0.1:8080

# 数据库配置，默认使用本地 SQLite。
STORAGE_DRIVER=sqlite
# sqlite: DATABASE_DSN=/data/infinite-canvas/infinite-canvas.db
# Docker/Zeabur 部署使用持久化卷路径，避免数据库与媒体索引随容器重建丢失。
# Canvas 媒体卷：总容量 10GB，默认预留 1GB；单用户默认上限 2GB；单文件默认上限 2GB。
CANVAS_DATA_DIR=/data/infinite-canvas
CANVAS_STORAGE_LIMIT_BYTES=10000000000
# 兼容历史 Zeabur 配置中的 CANVAS_MAX_STORAGE_BYTES；两者同时存在时以上面的新名称为准。
CANVAS_STORAGE_RESERVE_BYTES=1000000000
# 媒体池达到 8GB 时优先回收过期临时文件与超过保留期的无引用媒体；
# 仍不足时拒绝新写入。被资产、画布或历史引用的媒体不会自动删除。
CANVAS_STORAGE_CLEANUP_THRESHOLD_BYTES=8000000000
CANVAS_USER_STORAGE_LIMIT_BYTES=2000000000
CANVAS_MAX_OBJECT_BYTES=2147483648
CANVAS_UNREFERENCED_RETENTION_HOURS=72
# mysql 目标库不存在时会尝试自动创建，账号需有 CREATE 权限。
# mysql: DATABASE_DSN=user:password@tcp(127.0.0.1:3306)/infinite_canvas?parseTime=true
# postgres 目标库不存在时会尝试自动创建，账号需有 CREATEDB 权限。
# postgres: DATABASE_DSN=postgres://user:password@127.0.0.1:5432/infinite_canvas?sslmode=disable
DATABASE_DSN=/data/infinite-canvas/infinite-canvas.db
